{
  "expo": {
    "name": "RDO",
    "slug": "RDO",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.rdo.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#333333",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.com.rdo.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "RDO - Diário de Obra",
      "shortName": "RDO"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "O RDO acessa suas fotos para anexá-las ao diário da obra.",
          "cameraPermission": "O RDO usa a câmera para registrar fotos datadas dos serviços."
        }
      ]
    ]
  }
}
